DATABASE_URL="postgresql://user:password@localhost:5432/blog"
SESSION_SECRET="change-me"
PORT=5000
NODE_ENV=development

# Image uploads (S3) — bucket must allow public-read on the objects this
# service writes; the server proxies the upload through, it doesn't issue
# presigned URLs.
AWS_REGION="us-east-1"
AWS_S3_BUCKET="change-me"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"

# Redis (BullMQ queues for the follow/notification system). The worker
# process (`yarn worker`) and the API server both need this — the API only
# to enqueue a fanout job, the worker to consume it.
REDIS_URL="redis://localhost:6379"

# Outbound email (author-follow "new post" notifications). Sending is lazy —
# the app and API keep working without these set; only the notification
# worker's send-email step needs them, and it marks the notification FAILED
# (retryable) rather than crashing if they're missing.
SMTP_HOST="change-me"
SMTP_PORT=587
SMTP_USER="change-me"
SMTP_PASS="change-me"
EMAIL_FROM="Why Is It NOT Possible? <notifications@whyisitnotpossible.com>"

# Base URL of the frontend, used to build links in notification emails
# (post link + manage-notification-preferences link).
FRONTEND_URL="http://localhost:5173"

# Comma-separated list of origins allowed to make credentialed (cookie-
# carrying) requests to this API. Falls back to FRONTEND_URL if unset — set
# this explicitly in production if you serve the frontend from more than
# one origin (e.g. both the apex domain and www).
#CORS_ALLOWED_ORIGINS="https://whyisitnotpossible.com,https://www.whyisitnotpossible.com"
