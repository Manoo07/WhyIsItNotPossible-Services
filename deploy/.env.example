# Copy this to .env in the same folder and fill in real values.

# --- Database ---
# This deployment points at an existing database (not a self-managed
# Postgres container — docker-compose no longer runs one). Use the same
# connection string whyisitnotpossible-services/.env uses for local dev,
# or a separate production database if you want dev/prod data kept apart.
# Include ?sslmode=require if your provider needs it (Neon/Supabase/RDS
# typically do).
DATABASE_URL=change-me

# --- Domain + HTTPS (certbot) — see deploy/README.md and init-certbot.sh ---
# The real domain, no scheme/protocol (e.g. whyisitnotpossible.com, not
# https://...). Must also be edited directly into whyisitnotpossible-ui/nginx.conf
# (replace every "YOUR_DOMAIN") since nginx can't read this env var itself.
DOMAIN=change-me
# Let's Encrypt wants a real contact address for expiry/renewal notices.
CERTBOT_EMAIL=change-me

# --- Backend (whyisitnotpossible-services) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Requires HTTPS (see DOMAIN above) — a `secure` cookie is silently dropped
# by the browser over plain HTTP, which makes login look like it works (200
# response) but never actually persist. Only set this to false if you're
# deliberately still on the old bare-HTTP-IP setup with no domain yet.
COOKIE_SECURE=true

# Image uploads (S3) — bucket must allow public-read on the objects this
# service writes.
AWS_REGION=us-east-1
AWS_S3_BUCKET=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# Outbound email (registration OTP, password reset, author-follow
# notifications). Sending is lazy — the app keeps working without these
# set; only an actual send attempt fails (logged, not fatal).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=change-me
SMTP_PASS=change-me
EMAIL_FROM="Why Is It NOT Possible? <info@example.com>"

# Set these to https://<your-domain> (no trailing slash, matching DOMAIN
# above) — used to build links in notification emails, the sitemap
# (sitemap.service.ts), and to allow the frontend's cookie-carrying
# requests through CORS. Update both together; they should point at the
# same origin actually in the browser's address bar.
FRONTEND_URL=https://CHANGE_ME_TO_YOUR_DOMAIN
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_TO_YOUR_DOMAIN
